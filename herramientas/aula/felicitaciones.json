ant;margin:12px 0 4px!important}.ova-felic-tarjeta .ova-felic a{font-size:13px!important}}@supports not (container-type:inline-size){@media (max-width:720px){.ova-felic-tarjeta .ova-felic{position:static!important;margin:14px 0 4px!important}}}.ova-felic a{display:inline-flex;align-items:center;gap:10px;border:2px solid #000;border-radius:999px;font-family:Montserrat,Arial,sans-serif;font-weight:700;text-decoration:none;color:#000;line-height:1.2;transition:transform .15s,box-shadow .15s}.ova-felic a:hover{transform:translate(-1px,-1px)}.ova-felic a:focus-visible{outline:3px solid #E46042;outline-offset:3px}.ova-felic .ova-felic-video{background:#F6DDCB;font-size:18px;padding:13px 30px 13px 14px;box-shadow:4px 4px 0 #000;animation:ovaFelicLate 1.8s ease-in-out 3}.ova-felic .ova-felic-video:hover{box-shadow:6px 6px 0 #000}.ova-felic .ova-felic-memorias{background:#fff;font-size:15px;padding:10px 22px 10px 12px;box-shadow:3px 3px 0 #000}.ova-felic .ova-felic-ico{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:#000;color:#fff}.ova-felic .ova-felic-memorias .ova-felic-ico{width:30px;height:30px;background:#489084}.ova-felic svg{width:55%;height:55%}@keyframes ovaFelicLate{50%{box-shadow:4px 4px 0 #000,0 0 0 8px rgba(200,117,79,.45)}}@media (prefers-reduced-motion:reduce){.ova-felic .ova-felic-video{animation:none}.ova-felic a{transition:none}}.ova-felic-fondo{position:fixed;inset:0;z-index:10050;background:rgba(20,28,32,.72);display:flex;align-items:center;justify-content:center;padding:16px}.ova-felic-fondo[hidden]{display:none}.ova-felic-ventana{position:relative;width:min(1120px,96vw);height:min(640px,90vh);background:#fff;border:2px solid #000;border-radius:18px;box-shadow:6px 6px 0 #000;display:flex;flex-direction:column;overflow:hidden}.ova-felic-barra{display:flex;align-items:center;gap:12px;padding:8px 10px 8px 16px;border-bottom:2px solid #000;background:#E3EDE7}.ova-felic-barra h2{flex:1;margin:0;font:700 16px/1.25 Montserrat,Arial,sans-serif;color:#000;text-align:left;display:flex;align-items:center;gap:10px}.ova-felic-tico{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#000;color:#fff}.ova-felic-tico svg{width:55%;height:55%}.ova-felic-cerrar{display:inline-flex;align-items:center;gap:6px;border:2px solid #000;border-radius:999px;background:#fff;color:#000;font:700 14px Montserrat,Arial,sans-serif;padding:6px 14px;cursor:pointer;box-shadow:2px 2px 0 #000}.ova-felic-cerrar:focus-visible{outline:3px solid #E46042;outline-offset:2px}.ova-felic-marco{flex:1;border:0;width:100%;min-height:0;background:#000}@media (max-width:600px){.ova-felic .ova-felic-video{font-size:16px;padding:11px 20px 11px 12px}.ova-felic-ventana{height:min(560px,88vh);border-radius:14px}}\",PLAY=\"\\u003csvg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\u003cpath d=\\\"M8 5.5v13l11-6.5z\\\" fill=\\\"currentColor\\\"/\\u003e\\u003c/svg\\u003e\",BAJAR=\"\\u003csvg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\u003cpath d=\\\"M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/\\u003e\\u003c/svg\\u003e\",U=4,CM=@@CMREC@@,VIDEO=\"ap-u4-cierre\",TITULO=\"Video de cierre \\u00b7 Unidad 4\";\n /* 17/11/2026 (Esteban: «donde dice ver video de cierre de la unidad, no abre»): al abrir la sección, Moodle vuelve a ejecutar\n    el script desde <head>, y su contenedor dejaba de ser la tarjeta: el botón quedaba como enlace a «Recursos académicos», que\n    ya no muestra el video. Ahora la tarjeta se busca por el enlace del botón (id del recurso, único por unidad), con\n    reintentos mientras la sección termina de cargar. */\n var sc=document.currentScript;\n function buscarRaiz(){\n  var r=sc&&sc.parentNode;if(r&&r.querySelector&&r.querySelector('.ova-felic'))return r;\n  var cs=document.querySelectorAll('.ova-felic'),re=new RegExp('[?&]id='+CM+'(?![0-9])');\n  for(var i=0;i<cs.length;i++){var v=cs[i].querySelector('.ova-felic-video');if(v&&re.test(v.getAttribute('href')||''))return cs[i].parentNode}\n  return null;\n }\n var intentos=0;(function esperar(){var r=buscarRaiz();if(r){montar(r);return}if(++intentos<40)setTimeout(esperar,250)})();\n function montar(raiz){\n if(raiz.getAttribute('data-ova-felic-listo'))return;\n raiz.setAttribute('data-ova-felic-listo','1');\n if(!document.getElementById('ova-felic-css')){var st=document.createElement('style');st.id='ova-felic-css';st.textContent=CSS;document.head.appendChild(st)}\n var caja=raiz.querySelector('.ova-felic');if(!caja)return;\n var bVideo=caja.querySelector('.ova-felic-video'),bMem=caja.querySelector('.ova-felic-memorias');\n function ico(a,svg){if(a&&!a.querySelector('.ova-felic-ico')){var s=document.createElement('span');s.className='ova-felic-ico';s.innerHTML=svg;a.insertBefore(s,a.firstChild)}}\n ico(bVideo,PLAY);ico(bMem,BAJAR);\n if(bMem){bMem.removeAttribute('target');if(!/forcedownload=1/.test(bMem.href)&&/pluginfile\\.php/.test(bMem.href))bMem.href+=(bMem.href.indexOf('?')<0?'?':'&')+'forcedownload=1';bMem.setAttribute('download','')}\n if(!bVideo)return;\n var raizMoodle=(window.M&&M.cfg&&M.cfg.wwwroot)||'';\n var reproductor=window.OVA_FELIC_REPRODUCTOR||null;\n function buscar(){\n  if(reproductor)return Promise.resolve(reproductor);\n  if(!window.fetch||!raizMoodle)return Promise.reject();\n  return fetch(raizMoodle+'/mod/resource/view.php?id='+CM+'&redirect=1',{credentials:'same-origin'}).then(function(r){\n   var m=/^(.*\\/mod_resource\\/content\\/\\d+\\/)/.exec(r.url||'');if(!m)throw 0;\n   reproductor=m[1]+'unidad-0'+U+'/videos/index.html?video='+VIDEO;return reproductor});\n }\n var fondo=null,marco=null,antes=null;\n function cerrar(){if(!fondo||fondo.hidden)return;fondo.hidden=true;marco.src='about:blank';document.removeEventListener('keydown',tecla,true);if(antes)antes.focus()}\n function tecla(e){\n  if(e.key==='Escape'){e.preventDefault();cerrar();return}\n  if(e.key==='Tab'){var f=[fondo.querySelector('.ova-felic-cerrar'),marco];var i=f.indexOf(document.activeElement);\n   if(e.shiftKey&&i<=0){e.preventDefault();f[f.length-1].focus()}else if(!e.shiftKey&&i===f.length-1){e.preventDefault();f[0].focus()}}\n }\n function abrir(url){\n  if(!fondo){\n   fondo=document.createElement('div');fondo.className='ova-felic-fondo';fondo.hidden=true;\n   fondo.innerHTML='<div class=\"ova-felic-ventana\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ova-felic-t'+U+'\"><div class=\"ova-felic-barra\"><h2 id=\"ova-felic-t'+U+'\"></h2><button type=\"button\" class=\"ova-felic-cerrar\"><span aria-hidden=\"true\">✕</span> Cerrar</button></div><iframe class=\"ova-felic-marco\" allow=\"autoplay; fullscreen\" allowfullscreen></iframe></div>';\n   /* Ícono de video en el título de la ventana (JP, reunión del 12/11/2026, 19:06: «colocarle aquí la iconografía… siempre en el titulito»). */\n   var h2=fondo.querySelector('h2');h2.innerHTML='<span class=\"ova-felic-tico\">'+PLAY+'</span>';h2.appendChild(document.createTextNode(TITULO));\n   marco=fondo.querySelector('iframe');marco.title=TITULO;\n   fondo.querySelector('.ova-felic-cerrar').addEventListener('click',cerrar);\n   fondo.addEventListener('click',function(e){if(e.target===fondo)cerrar()});\n   document.body.appendChild(fondo);\n  }\n  antes=document.activeElement;marco.src=url;fondo.hidden=false;\n  document.addEventListener('keydown',tecla,true);\n  fondo.querySelector('.ova-felic-cerrar').focus();\n }\n bVideo.setAttribute('role','button');bVideo.setAttribute('aria-haspopup','dialog');\n bVideo.addEventListener('click',function(e){\n  e.preventDefault();var ir=bVideo.href;\n  buscar().then(abrir,function(){window.location.href=ir});\n });\n }\n})();</script>\n</div>\n"}